generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENTE
  ADMIN
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String?
  role      Role     @default(CLIENTE)
  image     String?
  sedeId    String?
  sede      Sede?    @relation(fields: [sedeId], references: [id])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userPlans     UserPlan[]
  planOrders    PlanOrder[] // <-- agregamos relación de órdenes de planes
  productOrders ProductOrder[] // <-- agregamos relación de órdenes de productos
}

model Sede {
  id          String   @id @default(cuid())
  nombre      String
  direccion   String
  ciudad      String
  telefono    String
  email       String?
  descripcion String   @db.Text
  imagen      String?
  latitud     Float?
  longitud    Float?
  horario     String
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  usuarios      User[]
  noticias      Noticia[]
  planesEnSede  PlanSede[]
  productos     Producto[]
  payments      Payment[]
  planOrders    PlanOrder[]
  productOrders ProductOrder[]

  paymentGateway   PaymentGateway? @relation(fields: [paymentGatewayId], references: [id])
  paymentGatewayId String?
}

model PaymentGateway {
  id          String @id @default(cuid())
  nombre      String
  tipo        String
  cuentaBanco String

  sedes Sede[]
}

model Plan {
  id          String   @id @default(cuid())
  nombre      String
  precio      Float
  descripcion String   @db.Text
  beneficios  String[] @default([])
  duracion    String
  tipo        String   @default("STANDARD")
  esVip       Boolean  @default(false)
  activo      Boolean  @default(true)
  destacado   Boolean  @default(false)
  orden       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sedes      PlanSede[]
  orderItems PlanOrder[]
  userPlans  UserPlan[]
}

model PlanSede {
  id        String   @id @default(cuid())
  planId    String
  sedeId    String
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  sede      Sede     @relation(fields: [sedeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([planId, sedeId])
}

model UserPlan {
  id        String    @id @default(cuid())
  userId    String
  planId    String
  plan      Plan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  startDate DateTime  @default(now())
  endDate   DateTime?
  isActive  Boolean   @default(true)
  paymentId String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, planId])
  @@index([userId])
  @@index([planId])
}

model Noticia {
  id               String    @id @default(cuid())
  titulo           String
  contenido        String    @db.Text
  resumen          String?
  imagen           String?
  sedeId           String?
  sede             Sede?     @relation(fields: [sedeId], references: [id])
  esPromocion      Boolean   @default(false)
  fechaInicio      DateTime?
  fechaFin         DateTime?
  activo           Boolean   @default(true)
  destacado        Boolean   @default(false)
  fechaPublicacion DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Producto {
  id          String   @id @default(cuid())
  nombre      String
  descripcion String   @db.Text
  precio      Float
  imagen      String?
  categoria   String   @default("GENERAL")
  stock       Int      @default(0)
  activo      Boolean  @default(true)
  destacado   Boolean  @default(false)
  sedeId      String?
  sede        Sede?    @relation(fields: [sedeId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems ProductOrder[]
}

model PlanOrder {
  id         String   @id @default(cuid())
  userId     String
  planId     String
  sedeId     String
  paymentId  String?
  quantity   Int      @default(1)
  unitPrice  Float
  totalPrice Float
  status     String   @default("PENDING") // PENDING, VERIFIED, CANCELLED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan    Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  sede    Sede     @relation(fields: [sedeId], references: [id], onDelete: SetNull)
  payment Payment? @relation(fields: [paymentId], references: [id])
}

model ProductOrder {
  id             String   @id @default(cuid())
  userId         String
  productId      String
  sedeId         String
  paymentId      String?
  quantity       Int
  unitPrice      Float
  totalPrice     Float
  status         String   @default("PENDING") // PENDING, PACKED, SHIPPED, DELIVERED, CANCELLED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  // Shipping information
  shippingAddress String?  // Full address
  shippingCity    String?  // City
  shippingState   String?  // Department/State
  shippingPhone   String?  // Contact phone
  shippingNotes   String?  // Additional notes
  postalCode      String?  // Postal code

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Producto @relation(fields: [productId], references: [id], onDelete: Cascade)
  sede    Sede     @relation(fields: [sedeId], references: [id], onDelete: SetNull)
  payment Payment? @relation(fields: [paymentId], references: [id])
}

model Payment {
  id              String   @id @default(cuid())
  sedeId          String
  amount          Float
  paymentMethod   String
  status          String   @default("PENDING") // PENDING, COMPLETED, FAILED
  transactionId   String   @unique
  gatewayResponse Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sede          Sede           @relation(fields: [sedeId], references: [id])
  planOrders    PlanOrder[]
  productOrders ProductOrder[]
}
