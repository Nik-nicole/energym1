generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  createdAt     DateTime       @default(now())
  firstName     String
  image         String?
  isActive      Boolean        @default(true)
  lastName      String?
  password      String
  role          Role           @default(CLIENTE)
  sedeId        String?
  updatedAt     DateTime       @updatedAt
  planOrders    PlanOrder[]
  productOrders ProductOrder[]
  sede          Sede?          @relation(fields: [sedeId], references: [id])
  userPlans     UserPlan[]
}

model Sede {
  id               String          @id @default(cuid())
  nombre           String
  direccion        String
  ciudad           String
  telefono         String
  email            String?
  descripcion      String
  latitud          Float?
  longitud         Float?
  horario          String
  activo           Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  paymentGatewayId String?
  imagenes         String[]
  noticias         Noticia[]
  payments         Payment[]
  planOrders       PlanOrder[]
  planesEnSede     PlanSede[]
  productOrders    ProductOrder[]
  productos        Producto[]
  paymentGateway   PaymentGateway? @relation(fields: [paymentGatewayId], references: [id])
  usuarios         User[]
}

model PaymentGateway {
  id          String @id @default(cuid())
  cuentaBanco String
  nombre      String
  tipo        String
  sedes       Sede[]
}

model Plan {
  id          String      @id @default(cuid())
  createdAt   DateTime    @default(now())
  activo      Boolean     @default(true)
  beneficios  String[]    @default([])
  descripcion String
  destacado   Boolean     @default(false)
  duracion    String
  esVip       Boolean     @default(false)
  nombre      String
  orden       Int         @default(0)
  precio      Float
  tipo        String      @default("STANDARD")
  updatedAt   DateTime    @updatedAt
  orderItems  PlanOrder[]
  sedes       PlanSede[]
  userPlans   UserPlan[]
}

model PlanSede {
  id        String   @id @default(cuid())
  planId    String
  sedeId    String
  createdAt DateTime @default(now())
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  sede      Sede     @relation(fields: [sedeId], references: [id], onDelete: Cascade)

  @@unique([planId, sedeId])
}

model UserPlan {
  id        String    @id @default(cuid())
  userId    String
  planId    String
  startDate DateTime  @default(now())
  endDate   DateTime?
  isActive  Boolean   @default(true)
  paymentId String?
  status    String    @default("ACTIVE")
  freezeDate DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  plan      Plan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, planId])
  @@index([userId])
  @@index([planId])
}

model Noticia {
  id               String    @id @default(cuid())
  titulo           String
  contenido        String
  resumen          String?
  imagen           String?
  sedeId           String?
  esPromocion      Boolean   @default(false)
  fechaInicio      DateTime?
  fechaFin         DateTime?
  activo           Boolean   @default(true)
  destacado        Boolean   @default(false)
  fechaPublicacion DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  sede             Sede?     @relation(fields: [sedeId], references: [id])
}

model Producto {
  id               String         @id @default(cuid())
  nombre           String
  descripcion      String
  precio           Float
  imagen           String?
  categoria        String         @default("GENERAL")
  stock            Int            @default(0)
  activo           Boolean        @default(true)
  destacado        Boolean        @default(false)
  sedeId           String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  orderItems       ProductOrder[]
  orderItemDetails ProductOrderItem[]
  sede             Sede?          @relation(fields: [sedeId], references: [id])
}

model PlanOrder {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  userId     String
  planId     String
  paymentId  String?
  quantity   Int      @default(1)
  sedeId     String
  totalPrice Float
  unitPrice  Float
  updatedAt  DateTime @updatedAt
  status     String   @default("PENDING")
  payment    Payment? @relation(fields: [paymentId], references: [id])
  plan       Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  sede       Sede     @relation(fields: [sedeId], references: [id], onDelete: SetNull)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProductOrder {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  userId          String
  paymentId       String?
  productId       String?
  quantity        Int
  sedeId          String
  totalPrice      Float
  unitPrice       Float?
  updatedAt       DateTime @updatedAt
  status          String   @default("PENDING")
  customerName    String?
  postalCode      String?
  shippingAddress String?
  shippingCity    String?
  shippingNotes   String?
  shippingPhone   String?
  shippingState   String?
  items           ProductOrderItem[]
  payment         Payment? @relation(fields: [paymentId], references: [id])
  product         Producto? @relation(fields: [productId], references: [id], onDelete: Cascade)
  sede            Sede     @relation(fields: [sedeId], references: [id], onDelete: SetNull)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProductOrderItem {
  id          String      @id @default(cuid())
  orderId     String
  productId   String
  quantity    Int
  unitPrice   Float
  totalPrice  Float
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  order       ProductOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Producto     @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Payment {
  id              String         @id @default(cuid())
  amount          Float
  createdAt       DateTime       @default(now())
  gatewayResponse Json?
  paymentMethod   String
  sedeId          String
  transactionId   String         @unique
  updatedAt       DateTime       @updatedAt
  status          String         @default("PENDING")
  sede            Sede           @relation(fields: [sedeId], references: [id])
  planOrders      PlanOrder[]
  productOrders   ProductOrder[]
}

enum Role {
  CLIENTE
  ADMIN
}
